@model List<Car>

<div class="d-flex justify-content-between">
    <a asp-controller="Cars"
       asp-action="Booked"
       class="btn btn-primary">
        Booked Cars
    </a>

    <a asp-controller="Cars"
       asp-action="Index"
       class="btn btn-primary">
        Back to Cars
    </a>
</div>
@if(Model.Count==0)
{
    <div class="alert alert-info">
        No booked cars 
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID </th>
                    <th>Car Name </th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td>@car.Name</td>
                        <td>@car.PricePerDay</td>
                        <td class="badge bg-warning text-dark">Booked</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
 
}

