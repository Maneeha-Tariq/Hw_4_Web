@model List<Car>

<h1 class="text-center"> <strong> Available Cars</strong></h1>
<p class="lead"> Select a car to book it.</p>
@if(Model.Count==0)
{
    <div class="alert alert-info">
        No cars are currently available
    </div>
}
else
{
    <div class="container">
        <div class="row g-3">
            @foreach (var car in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3">
                            <p class="card-text">Car Name: @car.Name</p>
                            <p class="card-text">Daily Price: PKR @car.PricePerDay</p>
                            <span class="badge bg-success">Available</span>

                            <form method="POST" action="/Cars/Book">
                                <input type="hidden" name="id" value="@car.Id" />
                                <button type="submit" class="btn btn-primary w-100">Book Car</button>
                            </form>

                        </div>
                    </div>
                </div>

            }
        </div>
    </div>

}

